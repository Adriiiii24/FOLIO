# Copiar a .env.local y rellenar. .env.local no se versiona.

# Supabase (Project Settings → API Keys). En local, `npx supabase status` da la URL y las claves.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: SOLO servidor (job programado). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Proveedores de IA (el AI SDK los lee de estas variables por defecto). Fase 3.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # solo si se usa Gemini como alternativa de visión

# Cron: cadena aleatoria de 32 caracteres o más; Vercel la envía como Bearer. Fase 3.
CRON_SECRET=
